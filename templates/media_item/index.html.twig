{% extends 'base.html.twig' %}

{% block title %}{{ 'Media Items List'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'Media Items List'|trans }}</h1>

    <div class="d-flex justify-content-between mb-3 align-items-center">
        <div class="d-flex align-items-center">
            <div class="form-check me-3">
                <input class="form-check-input" type="checkbox" id="isBorrowedCheckbox" {% if is_borrowed_view %}checked{% endif %}>
                <label class="form-check-label" for="isBorrowedCheckbox">
                    {{ 'Only borrowed'|trans }}
                </label>
            </div>

            <div class="btn-group">
                {# Always include the current isBorrowed state and locale in type filter links #}
                {% set borrowed_param = is_borrowed_view ? '1' : '0' %}

                <a href="{{ path('app_media_item_index', {'isBorrowed': borrowed_param, '_locale': app.request.locale}) }}" class="btn btn-{{ current_type is null ? 'primary' : 'secondary' }}">{{ 'All'|trans }}</a>
                <a href="{{ path('app_media_item_index', {'type': 'book', 'isBorrowed': borrowed_param, '_locale': app.request.locale}) }}" class="btn btn-{{ current_type == 'book' ? 'primary' : 'secondary' }}">{{ 'Books'|trans }}</a>
                <a href="{{ path('app_media_item_index', {'type': 'cd', 'isBorrowed': borrowed_param, '_locale': app.request.locale}) }}" class="btn btn-{{ current_type == 'cd' ? 'primary' : 'secondary' }}">{{ 'CDs'|trans }}</a>
                <a href="{{ path('app_media_item_index', {'type': 'dvd', 'isBorrowed': borrowed_param, '_locale': app.request.locale}) }}" class="btn btn-{{ current_type == 'dvd' ? 'primary' : 'secondary' }}">{{ 'DVDs'|trans }}</a>
            </div>
        </div>

        <div>
            <a href="{{ path('app_media_item_new', {'_locale': app.request.locale}) }}" class="btn btn-success">{{ 'Create New Item'|trans }}</a>
        </div>
    </div>

    <table class="table table-striped table-hover">
        <thead>
        <tr>
            <th>{{ 'Type'|trans }}</th>
            <th>{{ 'Title'|trans }}</th>
            <th>{{ 'Description'|trans }}</th>
            <th>{{ 'Acquisition Date'|trans }}</th>
            <th>{{ 'Borrowed To'|trans }}</th>
            <th>{{ 'Actions'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for media_item in media_items %}
            <tr>
                {# Volá se metoda getTypeName() z vaší entity MediaItem #}
                <td>{{ media_item.typeName|trans }}</td>

                {# Všechna data se tahají přímo z entity, žádné .entity mezikroky #}
                <td>{{ media_item.title }}</td>
                <td>{{ media_item.description }}</td>
                <td>{{ media_item.acquisitionDate ? media_item.acquisitionDate|date('Y-m-d') : '' }}</td>
                <td>{{ media_item.borrowedTo }}</td>
                <td>
                    <div class="d-flex gap-2">
                        <a href="{{ path('app_media_item_show', {'id': media_item.id, '_locale': app.request.locale}) }}" class="btn btn-sm btn-info">{{ 'Show'|trans }}</a>
                        <a href="{{ path('app_media_item_edit', {'id': media_item.id, '_locale': app.request.locale}) }}" class="btn btn-sm btn-warning">{{ 'Edit'|trans }}</a>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">{{ 'No records found.'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% block javascripts %}
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const isBorrowedCheckbox = document.getElementById('isBorrowedCheckbox');

                if (isBorrowedCheckbox) {
                    isBorrowedCheckbox.addEventListener('change', function() {
                        const currentUrl = new URL(window.location.href);
                        if (this.checked) {
                            currentUrl.searchParams.set('isBorrowed', '1');
                        } else {
                            currentUrl.searchParams.delete('isBorrowed');
                        }

                        // Ensure locale is preserved when changing filter
                        currentUrl.searchParams.set('_locale', '{{ app.request.locale }}');

                        const currentType = currentUrl.searchParams.get('type');
                        if (currentType) {
                            currentUrl.searchParams.set('type', currentType);
                        } else {
                            currentUrl.searchParams.delete('type');
                        }

                        window.location.href = currentUrl.toString();
                    });
                }
            });
        </script>
    {% endblock %}
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Evidence médií{% endblock %}

{% block body %}
    <h1>Evidence médií</h1>

    <div class="d-flex justify-content-between mb-3 align-items-center">
        <div class="d-flex align-items-center">
            <div class="form-check me-3">
                <input class="form-check-input" type="checkbox" id="isBorrowedCheckbox" {% if is_borrowed_view %}checked{% endif %}>
                <label class="form-check-label" for="isBorrowedCheckbox">
                    Jen zapůjčené
                </label>
            </div>

            <div class="btn-group">
                {# Always include the current isBorrowed state in type filter links #}
                {% set borrowed_param = is_borrowed_view ? '1' : '0' %}

                <a href="{{ path('app_media_item_index', {'isBorrowed': borrowed_param}) }}" class="btn btn-{{ current_type is null ? 'primary' : 'secondary' }}">Vše</a>
                <a href="{{ path('app_media_item_index', {'type': 'book', 'isBorrowed': borrowed_param}) }}" class="btn btn-{{ current_type == 'book' ? 'primary' : 'secondary' }}">Knihy</a>
                <a href="{{ path('app_media_item_index', {'type': 'cd', 'isBorrowed': borrowed_param}) }}" class="btn btn-{{ current_type == 'cd' ? 'primary' : 'secondary' }}">CD</a>
                <a href="{{ path('app_media_item_index', {'type': 'dvd', 'isBorrowed': borrowed_param}) }}" class="btn btn-{{ current_type == 'dvd' ? 'primary' : 'secondary' }}">DVD</a>
            </div>
        </div>

        <div>
            <a href="{{ path('app_media_item_new') }}" class="btn btn-success">Vytvořit novou položku</a>
        </div>
    </div>

    <table class="table table-striped table-hover">
        <thead>
        <tr>
            <th>Typ</th>
            <th>Název</th>
            <th>Popis</th>
            <th>Datum pořízení</th>
            <th>Zapůjčeno</th>
            <th>Akce</th>
        </tr>
        </thead>
        <tbody>
        {% for media_item in media_items %}
            <tr>
                {# Volá se metoda getTypeName() z vaší entity MediaItem #}
                <td>{{ media_item.typeName }}</td>

                {# Všechna data se tahají přímo z entity, žádné .entity mezikroky #}
                <td>{{ media_item.title }}</td>
                <td>{{ media_item.description }}</td>
                <td>{{ media_item.acquisitionDate ? media_item.acquisitionDate|date('Y-m-d') : '' }}</td>
                <td>{{ media_item.borrowedTo }}</td>
                <td>
                    <div class="d-flex gap-2">
                        <a href="{{ path('app_media_item_show', {'id': media_item.id}) }}" class="btn btn-sm btn-info">Zobrazit</a>
                        <a href="{{ path('app_media_item_edit', {'id': media_item.id}) }}" class="btn btn-sm btn-warning">Upravit</a>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Nenalezeny žádné záznamy.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% block javascripts %}
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const isBorrowedCheckbox = document.getElementById('isBorrowedCheckbox');

                if (isBorrowedCheckbox) {
                    isBorrowedCheckbox.addEventListener('change', function() {
                        const currentUrl = new URL(window.location.href);
                        if (this.checked) {
                            currentUrl.searchParams.set('isBorrowed', '1');
                        } else {
                            currentUrl.searchParams.delete('isBorrowed');
                        }

                        const currentType = currentUrl.searchParams.get('type');
                        if (currentType) {
                            currentUrl.searchParams.set('type', currentType);
                        } else {
                            currentUrl.searchParams.delete('type');
                        }

                        window.location.href = currentUrl.toString();
                    });
                }
            });
        </script>
    {% endblock %}
{% endblock %}

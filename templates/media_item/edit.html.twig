{% extends 'base.html.twig' %}

{% block title %}{{ 'Edit MediaItem'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'Edit MediaItem'|trans }}</h1>

    {{ form_start(form, {'attr': {'id': 'media_item_form'}}) }} {# Add an ID to the form #}
        {{ form_widget(form) }}
    {{ form_end(form) }}

    <div class="d-flex gap-2 mt-3">
        {# Submit button for the main form, using the 'form' attribute to link it to the form #}
        <button type="submit" form="media_item_form" class="btn btn-primary">{{ button_label|default('Update')|trans }}</button>
        <a href="{{ path('app_media_item_index', {'_locale': app.request.locale}) }}" class="btn btn-secondary">{{ 'Back to list'|trans }}</a>
        {{ include('media_item/_delete_form.html.twig', {'_locale': app.request.locale}) }}
    </div>
{% endblock %}

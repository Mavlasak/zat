<form method="post" action="{{ path('app_media_item_delete', {'id': media_item.id, '_locale': app.request.locale}) }}" onsubmit="return confirm('{{ 'Are you sure you want to delete this item?'|trans }}');" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ media_item.id) }}">
    <button class="btn btn-danger">{{ 'Delete'|trans }}</button>
</form>

{% extends 'base.html.twig' %}

{% block title %}MediaItem{% endblock %}

{% block body %}
    <h1>MediaItem</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ media_item.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ media_item.title }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ media_item.description }}</td>
            </tr>
            <tr>
                <th>AcquisitionDate</th>
                <td>{{ media_item.acquisitionDate ? media_item.acquisitionDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>BorrowedTo</th>
                <td>{{ media_item.borrowedTo }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_media_item_index') }}">back to list</a>

    <a href="{{ path('app_media_item_edit', {'id': media_item.id}) }}">edit</a>

    {{ include('media_item/_delete_form.html.twig') }}
{% endblock %}

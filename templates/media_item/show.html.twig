{% extends 'base.html.twig' %}

{% block title %}{{ 'MediaItem Details'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'MediaItem Details'|trans }}</h1>

    <table class="table table-bordered table-striped">
        <tbody>
            <tr>
                <th>{{ 'Id'|trans }}</th>
                <td>{{ media_item.id }}</td>
            </tr>
            <tr>
                <th>{{ 'Title'|trans }}</th>
                <td>{{ media_item.title }}</td>
            </tr>
            <tr>
                <th>{{ 'Description'|trans }}</th>
                <td>{{ media_item.description }}</td>
            </tr>
            <tr>
                <th>{{ 'Acquisition Date'|trans }}</th>
                <td>{{ media_item.acquisitionDate ? media_item.acquisitionDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>{{ 'Borrowed To'|trans }}</th>
                <td>{{ media_item.borrowedTo }}</td>
            </tr>
        </tbody>
    </table>

    <div class="d-flex gap-2 mt-3">
        <a href="{{ path('app_media_item_index', {'_locale': app.request.locale}) }}" class="btn btn-secondary">{{ 'Back to list'|trans }}</a>
        <a href="{{ path('app_media_item_edit', {'id': media_item.id, '_locale': app.request.locale}) }}" class="btn btn-warning">{{ 'Edit'|trans }}</a>
        {{ include('media_item/_delete_form.html.twig', {'_locale': app.request.locale}) }}
    </div>
{% endblock %}
